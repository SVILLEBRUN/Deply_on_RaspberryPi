# MOVIE-DB-APP
DATABASE_URL_MDB=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
MDB_FRONTEND_URL=https://your-domain.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=change-me-long-random-string
NODE_ENV=development
# NODE_ENV=production


# PROXY_PORT=5000
PROXY_PORT=5001 # We use 5001 instead of 5000 because port 5000 is locked on MacOS

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
MAPBOX_API_KEY=your-mapbox-api-key

# AIRJEWELS
POSTGRES_USER_AIRJEWELS=airjewels
POSTGRES_PASSWORD_AIRJEWELS=change-me
POSTGRES_DB_AIRJEWELS=airjewels_development
POSTGRES_DB_AIRJEWELS_PROD=airjewels_production
AIRJEWELS_RAILS_SERVE_STATIC_FILES=true

SECRET_KEY_BASE_AIRJEWELS=change-me-long-random-string

# ACADEMINT
POSTGRES_USER_ACADEMINT=academint
POSTGRES_PASSWORD_ACADEMINT=change-me
POSTGRES_DB_ACADEMINT=academint_development
POSTGRES_DB_ACADEMINT_PROD=academint_production
ACADEMINT_SERVE_STATIC_FILES=true

SECRET_KEY_BASE_ACADEMINT=change-me-long-random-string


# PORTFOLIO
MAIL_TARGET=contact@your-domain.com
MAIL_USER=your-mailer@gmail.com
MAIL_PASS=your-app-password


# TV-TIME
POSTGRES_USER_TV_TIME=tv_time
# Used in DATABASE_URL: avoid characters that need URL-encoding (@ : / ? #)
POSTGRES_PASSWORD_TV_TIME=change-me
POSTGRES_DB_TV_TIME=tv_time_db
JWT_SECRET_TV_TIME=change-me-long-random-string
GOOGLE_CLIENT_ID_TV_TIME=your-google-client-id.apps.googleusercontent.com
TMDB_API_KEY=your-tmdb-api-key
TV_TIME_FRONT_URL=https://your-domain.com
# Password reset emails. With Gmail, SMTP_PASS is an app password
# (https://myaccount.google.com/apppasswords, requires 2-step verification)
# and MAIL_FROM must use the SMTP_USER address.
SMTP_HOST_TV_TIME=smtp.gmail.com
SMTP_PORT_TV_TIME=465
SMTP_USER_TV_TIME=your-mailer@gmail.com
SMTP_PASS_TV_TIME=your-app-password
MAIL_FROM_TV_TIME="TV Time <your-mailer@gmail.com>"
